# Copia este archivo como ".env" y completa los valores.
# El archivo .env NO se sube a GitHub.

# Clave compartida entre los nodos del clúster.
# Cualquier texto largo sin espacios; debe ser el mismo en todo el clúster.
RABBITMQ_COOKIE=cambia-esta-clave-del-cluster

# Usuario administrador de la consola web y de los microservicios
RABBITMQ_USER=vidasalud
RABBITMQ_PASSWORD=cambia-esta-clave
