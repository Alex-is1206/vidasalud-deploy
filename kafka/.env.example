# Host anunciado para conexiones desde fuera de la red Docker (PC local o 2da EC2)
# En desarrollo local usar: localhost
# En AWS con 2da EC2 usar la IP privada de la EC2 de Kafka (ej. 172.31.X.X)
KAFKA_EXTERNAL_HOST=localhost

# Puertos externos de los brokers
KAFKA1_EXTERNAL_PORT=9092
KAFKA2_EXTERNAL_PORT=9093
KAFKA3_EXTERNAL_PORT=9094

# Puerto local de Kafka UI (se publica en 127.0.0.1 para acceso por túnel SSH)
KAFKA_UI_PORT=8090