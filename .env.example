# Copia este archivo como ".env" y completa los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Contraseña del administrador de Oracle (SYS/SYSTEM)
ORACLE_PASSWORD=cambia-esta-clave

# Contraseña del usuario "vidasalud" que usan los microservicios
DB_PASSWORD=cambia-esta-clave

# Carpeta del BFF, relativa a esta carpeta.
# En tu PC es ../ms-vidasalud-bff-mio; en la EC2, ../ms-vidasalud-bff
BFF_DIR=../ms-vidasalud-bff

# Orígenes que el BFF acepta en llamadas directas (en la nube, el CORS lo hace el API Gateway)
CORS_ORIGINS=http://localhost:4200
